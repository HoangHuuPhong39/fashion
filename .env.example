# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG TADA! FASHION ATELIER (PRODUCTION & LOCAL)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Tạo file .env.local trên máy tính cá nhân hoặc điền vào Settings -> Environment Variables trên Vercel.
# 2. KHÔNG BAO GIỜ commit file .env.local hoặc để lộ các khóa bí mật lên Git công khai.
# ==============================================================================

# 1. TÊN MIỀN & GIAO DIỆN CÔNG KHAI
# URL gốc của website khi chạy thật (Ví dụ: https://tada-fashion.vn hoặc https://tada-atelier.vercel.app)
NEXT_PUBLIC_SITE_URL=https://tada-fashion.vn
NEXT_PUBLIC_HOTLINE=0366861159
NEXT_PUBLIC_CONTACT_EMAIL=contact@tada.vn

# 2. TÀI KHOẢN QUẢN TRỊ VIÊN ATELIER
# Bắt buộc đặt mật khẩu mạnh (tối thiểu 8 ký tự, chữ hoa, số và ký tự đặc biệt)
# Sau khi khởi tạo admin lần đầu, đổi mật khẩu định kỳ tại trang /account.
ADMIN_EMAIL=admin@tada.vn
ADMIN_INITIAL_PASSWORD=YourStrongAdminPassword2026!

# 3. CƠ SỞ DỮ LIỆU POSTGRESQL (NEON / SUPABASE)
# Chuỗi kết nối có SSL (pooler hoặc direct)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/tada_fashion?sslmode=require

# 4. BẢO MẬT BĂM IP VÀ RATE LIMIT (BẢO VỆ DỮ LIỆU CÁ NHÂN)
# Khóa bí mật dùng để băm HMAC-SHA256 địa chỉ IP truy cập (không lưu IP thô để tuân thủ Nghị định 13/2023/NĐ-CP)
IP_HASH_SECRET=your-random-32-byte-hex-secret-key-here

# 5. CHỐNG BOT & TẤN CÔNG BRUTE-FORCE (CLOUDFLARE TURNSTILE)
# Đăng ký miễn phí tại https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAx_sample_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx_sample_secret_key

# 6. BỘ ĐỆM DÙNG CHUNG RATE LIMIT (UPSTASH REDIS)
# Đăng ký miễn phí tại https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://sample-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 7. LƯU TRỮ HÌNH ẢNH SẢN PHẨM (OBJECT STORAGE)
# Tùy chọn A: Vercel Blob (Khuyên dùng khi deploy lên Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token

# Tùy chọn B: Cloudinary (Nếu dùng kho ảnh ngoài)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 8. XÁC MINH GOOGLE SEARCH CONSOLE
# Mã xác minh qua thẻ meta tag (hoặc dùng xác minh qua DNS TXT record)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_verification_token

# 9. DỊCH VỤ EMAIL GIAO DỊCH (RESEND)
# Đăng ký miễn phí tại https://resend.com/
RESEND_API_KEY=re_sample_api_key_here
EMAIL_FROM=TADA! Fashion Atelier <no-reply@tada-fashion.vn>

# 10. TỰ ĐỘNG XÁC NHẬN THANH TOÁN VIETQR (SEPAY HOẶC CASSO)
# Khóa API / Webhook secret để xác thực chữ ký (constant-time check)
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key_or_token
CASSO_SECURE_TOKEN=your_casso_secure_token

# 11. TÍNH PHÍ GIAO HÀNG TỰ ĐỘNG (GIAOHANGNHANH - GHN HOẶC GHTK)
GHN_API_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_FROM_DISTRICT_ID=1442

# 12. ĐĂNG NHẬP GOOGLE OAUTH 2.0 (PKCE)
# Tạo tại Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 13. KÊNH CHĂM SÓC KHÁCH HÀNG (ZALO & MESSENGER)
NEXT_PUBLIC_ZALO_PHONE=0366861159
NEXT_PUBLIC_MESSENGER_URL=https://m.me/tadafashionatelier

